    {
      "id": "text-62",
      "type": "text",
      "x": 50,
      "y": 1010,
      "width": 878,
      "height": 87,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "compare_demand_supply.py  and  bottomup_pipeline.py  each:\n  read generation_history.jsonl's global_anchor_2026 for the same market name (or --demand-value override)\n  compute relative_error = |demand_total - own_total| / demand_total\n  print + save a JSON report (per-company / per-country detail + the % gap)\nMentor's target: relative error within ~25-30%  --  accuracy tuning from there is his task, not this pipeline's.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "compare_demand_supply.py  and  bottomup_pipeline.py  each:\n  read generation_history.jsonl's global_anchor_2026 for the same market name (or --demand-value override)\n  compute relative_error = |demand_total - own_total| / demand_total\n  print + save a JSON report (per-company / per-country detail + the % gap)\nMentor's target: relative error within ~25-30%  --  accuracy tuning from there is his task, not this pipeline's.",
      "lineHeight": 1.25
    },
