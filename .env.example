# Copy to .env and fill in your own values. Never commit the real .env.

# ---- LLM provider ----
# Only one of these is required — config.py checks DEEPSEEK_API_KEY first,
# then OPENAI_API_KEY, then OPENROUTER_API_KEY.
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-v1-...

# Model selection
# openai/gpt-4o-mini      — via OpenRouter/OpenAI, uses local SQLite cache (fast, cheap re-runs)
# deepseek-chat           — via DeepSeek's own API, live calls + DDG evidence (needs outbound HTTP)
ME_CURVE_MODEL=deepseek-chat
ME_LLM_BASE_URL=https://api.deepseek.com
ME_LLM_TIMEOUT=90

# Evidence Agent (DDG web searches, curve/segmentation/ASP agents)
# Set to 1 when outbound network is available
ME_ENABLE_WEB_EVIDENCE=1
ME_EVIDENCE_CONFIDENCE_THRESHOLD=0.65
ME_EVIDENCE_MAX_RESULTS=6

# ---- Neon Postgres (report DB: market summaries + segmentation trees) ----
# Required for "Neon DB (any market)" mode and semantic report search.
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Synthetic Input-Sheet generator (LangGraph multi-agent fleet) ----
DEAGENT_MODEL=deepseek-chat
DEAGENT_LLM_BASE_URL=https://api.deepseek.com
# Evidence-refinement ("RL") loop bounds
DEAGENT_MAX_LOOP_ITERS=4
# Always run at least this many refine iterations before accepting
DEAGENT_MIN_LOOP_ITERS=2
# Reward threshold [0-1] at which the loop stops refining and accepts numbers
DEAGENT_REWARD_THRESHOLD=0.9
# Per-region share differentiation. 0 = one global vector per group (better
# when a market's shares are near-uniform across countries). 1 = the agent
# decides a distinct vector per region (reviewed for realism each iteration).
DEAGENT_PER_REGION_SHARES=0
